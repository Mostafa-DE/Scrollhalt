<resources>
    <string name="app_name">Scrollhalt</string>

    <string name="service_summary">Keeps you out of the Instagram Reels feed.</string>
    <string name="service_description">Scrollhalt reads the names of on-screen views inside the Instagram app (for example \"reel viewer\" or \"Reels tab\") to notice when Reels open, covers the Reels tab button, and taps Home or Back for you. From other apps it only notices that a window changed, to know you left Instagram. It does not read messages, captions or usernames, and nothing is stored or sent anywhere: the app has no internet permission.</string>

